# Do not commit a populated .env file.

VITE_API_URL=http://localhost:8000

# "demo" (default) keeps the local, labeled-non-production role selector.
# "supabase" enables real OIDC sign-in; requires the two values below and a
# matching backend PPE_AUTH_MODE=supabase configuration.
VITE_AUTH_MODE=demo
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
