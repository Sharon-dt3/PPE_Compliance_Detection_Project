# Request values from the platform/orchestrator; do not commit a populated .env file.
PPE_APP_NAME=PPE Compliance Detection POC
PPE_ALLOWED_ORIGINS=http://localhost:5173
PPE_MAX_UPLOAD_BYTES=104857600
PPE_EVIDENCE_RETENTION_HOURS=48

# SQLite is a zero-cost local default. Use a managed PostgreSQL URL for shared environments.
PPE_DATABASE_URL=sqlite:///./data/ppe_compliance.db

# Request a managed Redis endpoint when background processing is deployed.
PPE_REDIS_URL=redis://localhost:6379/0

# Keep uploads and generated evidence outside publicly served paths.
PPE_PRIVATE_MEDIA_DIRECTORY=./data/private-media
PPE_PRIVATE_EVIDENCE_DIRECTORY=./data/private-evidence
PPE_RAW_MEDIA_RETENTION_HOURS=1

# POC model configuration. Set DEMO_MODE=false only after the approved model is available.
PPE_DEMO_MODE=true
PPE_DETECTION_PROVIDER=demo
PPE_HF_MODEL_REPOSITORY=melihuzunoglu/ppe-detection
PPE_HF_MODEL_FILENAME=best.pt
PPE_LOCAL_MODEL_PATH=

# Mandatory privacy gate. Provide both files before enabling evidence.
PPE_FACE_DETECTOR_PROTOTXT_PATH=
PPE_FACE_DETECTOR_MODEL_PATH=
PPE_FACE_DETECTOR_CONFIDENCE=0.5
PPE_FACE_BLUR_PADDING_RATIO=0.15
PPE_FACE_BLUR_KERNEL_SIZE=31
